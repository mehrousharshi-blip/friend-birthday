"script.js": r'''function toggleMusic(){
  const audio=document.getElementById('song');
  const label=document.getElementById('musicLabel');
  if(!audio)return;
  if(audio.paused){audio.play().then(()=>{if(label)label.textContent='Pause music'}).catch(()=>{if(label)label.textContent='Tap to play'});}
  else{audio.pause();if(label)label.textContent='Play music';}
}'''
